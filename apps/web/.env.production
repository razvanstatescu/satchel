# apps/web production env for the Vercel testnet deployment.
# Committed on purpose, as the record of what the hosted app runs (apps/web/.gitignore excepts this one file). It holds
# public values only: every NEXT_PUBLIC_* value is inlined into the browser bundle at build time anyway, so a change
# needs a redeploy. The one secret, FASTNEAR_API_KEY, stays empty here and is set in Vercel as a Sensitive variable.
# Vercel → Settings → Environment Variables → Production ("Import .env" accepts this file as is).

# live = real reads (FastNEAR → dRPC), real wallets (near-connect), real BTC/ETH/SOL. fixture = demo data, mock wallet.
NEXT_PUBLIC_DATA_MODE=live
NEXT_PUBLIC_NETWORK=testnet

# The release contract (launch checklist E-03): born keyless in one transaction with no AddKey, so it has no access
# key and its code can never change. Role final = the strict clean-history gate (lock + code hash, fail closed).
# The development contracts (dev1, dev2) keep their keys; they are history now.
NEXT_PUBLIC_SATCHEL_CONTRACT=satchel.satchelhq.testnet
NEXT_PUBLIC_CONTRACT_ROLE=final
NEXT_PUBLIC_MPC_CONTRACT=v1.signer-prod.testnet
# Circle testnet USDC on NEAR
NEXT_PUBLIC_USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# H: the SHA-256 of the reproducible wasm at tag contract-v1.0.0, deployed at the birth (docs/verify.md steps 2 and
# 6). Required for role final: the strict gate fails closed when the deployed code does not match it.
NEXT_PUBLIC_EXPECTED_CODE_HASH=42d12b441f85b3208f97e1b8c6cc7b7ad3198f97d971f5d7651caf749706d8fa

# The public URL: the custom domain (D-49). It must match the contract's base_uri
# (https://usesatchel.xyz/api/card/), which is immutable per contract and fixed at the final birth.
NEXT_PUBLIC_APP_URL=https://usesatchel.xyz

# Bitcoin, Ethereum and Solana everywhere (D-46). "off" is the cut switch.
NEXT_PUBLIC_SOL_UI=on
NEXT_PUBLIC_SOL_SEND=on

# Endpoint lists: empty = the built-in defaults (kb/90 §8.3): FastNEAR + dRPC; publicnode, ethpandaops, 0xrpc,
# tenderly; mempool.space + emzy; Solana devnet. The deprecated near.org testnet RPC is refused.
NEXT_PUBLIC_NEAR_RPCS=
NEXT_PUBLIC_NEAR_TX_API=
NEXT_PUBLIC_SEPOLIA_RPCS=
NEXT_PUBLIC_BTC_APIS=
NEXT_PUBLIC_SOL_RPCS=

# Server only (never NEXT_PUBLIC_*). Optional: dashboard.fastnear.com. Add it in Vercel as a Sensitive variable;
# leave it empty here.
FASTNEAR_API_KEY=
