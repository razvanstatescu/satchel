# apps/web production env for the Vercel testnet deployment (written 2026-10-29).
# Not committed: `.env*` is gitignored. Paste it into Vercel → Settings → Environment Variables → Production
# ("Import .env" accepts this file as is).
# Every NEXT_PUBLIC_* value is public and is inlined into the browser bundle at build time, so a change needs a
# redeploy. Only FASTNEAR_API_KEY is secret.

# live = real reads (FastNEAR → dRPC), real wallets (near-connect), real BTC/ETH/SOL. fixture = demo data, mock wallet.
NEXT_PUBLIC_DATA_MODE=live
NEXT_PUBLIC_NETWORK=testnet

# Until Day 9 the app runs on a dev contract (it keeps its key; D-48). dev2 (2026-10-29) carries every sprint feature
# (C1–C7 + the M-01 fix); dev1 is the pre-sprint contract and can't be upgraded in place (the state layout changed).
# Day 9: rc.satchelhq.testnet + ROLE=rc. Day 10: satchel.satchelhq.testnet + ROLE=final (launch checklist E-03).
NEXT_PUBLIC_SATCHEL_CONTRACT=dev2.satchelhq.testnet
NEXT_PUBLIC_CONTRACT_ROLE=dev
NEXT_PUBLIC_MPC_CONTRACT=v1.signer-prod.testnet
# Circle testnet USDC on NEAR
NEXT_PUBLIC_USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# SHA-256 of the wasm deployed on dev2 (main 56cd631, non-reproducible build). It is required for rc/final, where the
# strict gate fails closed without it. Replace it with the reproducible-build hash H on Day 9.
NEXT_PUBLIC_EXPECTED_CODE_HASH=10c6a8e9096b682791f4ebe282861314b0f51b8be0c54e11b7f057c53353614a

# The public URL: the custom domain (D-49). It must match the contract's base_uri
# (https://usesatchel.xyz/api/card/), which is immutable per contract and fixed at the final birth.
NEXT_PUBLIC_APP_URL=https://usesatchel.xyz

# Bitcoin, Ethereum and Solana everywhere (D-46). "off" is the cut switch.
NEXT_PUBLIC_SOL_UI=on
NEXT_PUBLIC_SOL_SEND=on

# Endpoint lists: empty = the built-in defaults (kb/90 §8.3): FastNEAR + dRPC; publicnode, ethpandaops, 0xrpc,
# tenderly; mempool.space + emzy; Solana devnet. The deprecated near.org testnet RPC is refused.
NEXT_PUBLIC_NEAR_RPCS=
NEXT_PUBLIC_NEAR_TX_API=
NEXT_PUBLIC_SEPOLIA_RPCS=
NEXT_PUBLIC_BTC_APIS=
NEXT_PUBLIC_SOL_RPCS=

# Server only (never NEXT_PUBLIC_*). Optional: dashboard.fastnear.com. Add it in Vercel as a Sensitive variable;
# leave it empty here.
FASTNEAR_API_KEY=
