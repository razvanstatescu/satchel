# apps/web environment (kb/90 §8.4). No values are committed; copy to .env.local.
# fixture = sample views (no contract needed; the mock wallet + in-browser simulation drive the flows)
# live    = real RPC reads (FastNEAR → dRPC), real wallets (near-connect), real chains
NEXT_PUBLIC_DATA_MODE=fixture
NEXT_PUBLIC_NETWORK=testnet
# devN.satchelhq.testnet until Day 9 · rc.satchelhq.testnet (rehearsal) · satchel.satchelhq.testnet from Day 10
NEXT_PUBLIC_SATCHEL_CONTRACT=satchel.satchelhq.testnet
# dev | rc | final — selects the clean-history gate mode and the role strip
NEXT_PUBLIC_CONTRACT_ROLE=dev
NEXT_PUBLIC_MPC_CONTRACT=v1.signer-prod.testnet
NEXT_PUBLIC_USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# SHA-256 hex of the reproducible wasm; required for rc/final (missing ⇒ the strict gate fails closed: unsafe)
NEXT_PUBLIC_EXPECTED_CODE_HASH=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma lists (defaults: kb/90 §8.3). The deprecated near.org testnet RPC is refused.
NEXT_PUBLIC_NEAR_RPCS=
NEXT_PUBLIC_NEAR_TX_API=
NEXT_PUBLIC_SEPOLIA_RPCS=
NEXT_PUBLIC_BTC_APIS=
NEXT_PUBLIC_SOL_RPCS=
# Solana (P2, cut-1): on | off. SOL_UI = SOL in cards/wallet/receive (implies SOL_SEND); SOL_SEND = the send flow only
NEXT_PUBLIC_SOL_UI=off
NEXT_PUBLIC_SOL_SEND=off
# Server only — never NEXT_PUBLIC_*
FASTNEAR_API_KEY=
