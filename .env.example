# Satchel environment variables (kb/90 §8.4). Copy to .env.local (never committed) and fill in.
# No values are committed here on purpose. The defaults in comments are what the code uses when a variable is unset.
# Never put a key or secret in a NEXT_PUBLIC_* variable: those are inlined into the browser bundle.

# ---------------------------------------------------------------- apps/web (public, inlined at build time)
# testnet (default; the app runs on testnet only. "mainnet" is accepted only to switch off testnet-only labels)
NEXT_PUBLIC_NETWORK=
# dev1.satchelhq.testnet until Day 9 · rc.satchelhq.testnet for the Day-9 rehearsal · satchel.satchelhq.testnet from Day 10
NEXT_PUBLIC_SATCHEL_CONTRACT=
# dev | rc | final: the clean-history gate mode and banner (kb/90 §7.3). Default dev
NEXT_PUBLIC_CONTRACT_ROLE=
# default v1.signer-prod.testnet
NEXT_PUBLIC_MPC_CONTRACT=
# default 3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af (Circle testnet USDC)
NEXT_PUBLIC_USDC_CONTRACT=
# SHA-256 hex of the reproducible wasm (H). REQUIRED for rc and final; missing means "unsafe" by design
NEXT_PUBLIC_EXPECTED_CODE_HASH=
# https://<app-host>, must equal the contract's base_uri host (default http://localhost:3000)
NEXT_PUBLIC_APP_URL=
# fixture | live. Default fixture (sample data + a visible strip). Production MUST set live
NEXT_PUBLIC_DATA_MODE=
# comma lists; defaults are kb/90 §8.3 (apps/web/src/lib/config.ts). The deprecated near.org testnet RPC is refused
NEXT_PUBLIC_NEAR_RPCS=
# default https://tx.test.fastnear.com (canonical NEAR history and tx proofs)
NEXT_PUBLIC_NEAR_TX_API=
NEXT_PUBLIC_SEPOLIA_RPCS=
NEXT_PUBLIC_BTC_APIS=
NEXT_PUBLIC_SOL_RPCS=
# on | off (default on, D-46): the Solana UI (cards, wallet rows, Receive, Send, Mint); off is the cut switch
NEXT_PUBLIC_SOL_UI=
# on | off (default off): the Solana send flow alone; NEXT_PUBLIC_SOL_UI=on implies it
NEXT_PUBLIC_SOL_SEND=

# ---------------------------------------------------------------- server only (Vercel env var; never NEXT_PUBLIC_)
# dashboard.fastnear.com key (H-06, optional: dRPC works without a key). Sent only to fastnear hosts
FASTNEAR_API_KEY=
# onboarding survey store (POST /api/onboarding, apps/web/README.md; also read by tools/onboarding-report.ts).
# Unset: the route answers 204 and stores nothing. The Vercel Upstash integration injects the first pair
KV_REST_API_URL=
KV_REST_API_TOKEN=
# fallbacks: the plain Upstash dashboard's names
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- apps/web font scripts (pnpm --filter web fonts:card / fonts:og)
# download cache for the font sources (default <os tmpdir>/satchel-card-fonts)
# CARD_FONT_CACHE=   (leave unset rather than empty: the scripts read it with `??`)

# ---------------------------------------------------------------- apps/web Playwright
# run the read-only judge checks against a deployed URL instead of a local fixture build
E2E_BASE_URL=
# local port for the fixture build (default 3340; pick any free port)
E2E_PORT=

# ---------------------------------------------------------------- tools/e2e and tools/deploy (TypeScript scripts)
# team account name (default satchelhq, D-38) → satchelhq.testnet, dev1./rc./satchel.satchelhq.testnet, personas
SATCHEL_TEAM=
# dev | rc | final (default dev); picks the contract unless SATCHEL_CONTRACT is set
SATCHEL_ROLE=
SATCHEL_CONTRACT=
# personas (default alice./bob./carol.<team>.testnet)
SATCHEL_ALICE=
SATCHEL_BOB=
SATCHEL_CAROL=
# overrides of the NEXT_PUBLIC_* lists above for the scripts
SATCHEL_NEAR_RPCS=
SATCHEL_NEAR_TX_API=
SATCHEL_SEPOLIA_RPCS=
SATCHEL_BTC_APIS=
SATCHEL_SOL_RPCS=
SATCHEL_MPC_CONTRACT=
SATCHEL_USDC_CONTRACT=
# H for the strict clean-history gate (rc/final) and for the judge snippets
SATCHEL_EXPECTED_CODE_HASH=
# where signing keys live (default ~/.near-credentials). Keys are never read from the repo
NEAR_CREDENTIALS_DIR=

# ---------------------------------------------------------------- tools/judge-snippets.sh and tools/monitor.sh (read-only)
SATCHEL_BIRTH_TX=
SATCHEL_BIRTH_BLOCK=
SATCHEL_APP_URL=
# token used by the snippets (default 1) and its expected owner (default alice.<team>.testnet)
SATCHEL_TOKEN=
SATCHEL_OWNER=
# NEAR RPC for the curl snippets (default https://near-testnet.drpc.org) and its fallback (https://test.rpc.fastnear.com)
SATCHEL_RPC=
SATCHEL_RPC_FALLBACK=
SATCHEL_TX_API=
# wasm to hash (default target/near/satchel/satchel.wasm); the sandbox suite reads the same variable
SATCHEL_WASM=
# Satchel #1's derived addresses (defaults: research/final-addresses.md, final #1)
SATCHEL_BTC_ADDRESS=
SATCHEL_EVM_ADDRESS=
SATCHEL_SOL_ADDRESS=
# monitor thresholds (spare NEAR: WARN below MIN, default 5; FAIL below ALERT, default 3) and the near-connect
# manifest baseline (R-34)
SATCHEL_MIN_LIQUID_NEAR=
SATCHEL_ALERT_LIQUID_NEAR=
SATCHEL_MANIFEST_URL=
SATCHEL_MANIFEST_SHA256=

# ---------------------------------------------------------------- tests/ (sandbox)
# e.g. 2.14.0-rc.5 to run the suite on testnet's nearcore (default 2.13.4)
SANDBOX_VERSION=
