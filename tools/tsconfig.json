{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "vectors/**/*.ts",
    "lib/**/*.ts",
    "e2e/**/*.ts",
    "deploy/**/*.ts",
    "test/**/*.ts"
  ]
}
