{
  "name": "@satchel/core",
  "version": "1.0.0",
  "private": true,
  "description": "Satchel framework-free libraries: derivation, NEAR payload encoders, chain builders, clean-history checker, card hue, formatting",
  "type": "module",
  "sideEffects": false,
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./src/index.ts",
    "./bytes": "./src/bytes.ts",
    "./derive": "./src/derive/index.ts",
    "./near": "./src/near/index.ts",
    "./near/constants": "./src/near/constants.ts",
    "./policy": "./src/policy/index.ts",
    "./policy/message-text": "./src/policy/message-text.ts",
    "./chains/evm": "./src/chains/evm/index.ts",
    "./chains/evm/networks-data": "./src/chains/evm/networks-data.ts",
    "./chains/btc": "./src/chains/btc/index.ts",
    "./chains/sol": "./src/chains/sol/index.ts",
    "./clean-history": "./src/clean-history/index.ts",
    "./card": "./src/card/index.ts",
    "./format": "./src/format/index.ts"
  },
  "scripts": {
    "test": "vitest run --exclude 'test/network/**' && node scripts/check-browser.mjs",
    "test:network": "vitest run test/network",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "2.0.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@solana/web3.js": "1.99.0",
    "bitcoinjs-lib": "7.0.4",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "esbuild": "0.28.2"
  }
}
